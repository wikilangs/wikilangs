---
import BaseLayout from '@layouts/BaseLayout.astro';
import languages from '@data/languages.json';
import '../../styles/playground.css';
const catalogue = languages.map(l => ({ code: l.code, name: l.name, direction: l.text_direction || 'ltr' }));
const config = JSON.stringify({ catalogue }).replace(/</g, '\\u003c');
---
<BaseLayout title="Playground" description="Follow a word and watch its possible futures unfold. Explore compact Wikipedia corpus data across languages.">
  <div class="playground-shell">
    <header class="playground-heading">
      <div><p class="lab-kicker">THE LANGUAGE LAB</p><h1>One word. Many futures.</h1><p class="lab-intro">Follow the likely path. Take the unexpected turn. See what changes.</p></div>
      <div class="language-control"><label for="corpus-language">Corpus language</label><select id="corpus-language" aria-describedby="corpus-status"><option value="">Choose a language</option>{catalogue.map(l => <option value={l.code}>{l.name} · {l.code}</option>)}</select><p id="corpus-status" role="status">Choose a language to explore</p></div>
    </header>
    <nav class="experience-tabs" aria-label="Playground experiences">
      <button data-demo="flow">Word Flow</button><button data-demo="weaver">Text Weaver</button><button data-demo="dna">Language DNA</button><button data-demo="zipf">Zipf's Law</button><button data-demo="museum">Word Cabinet</button><button data-demo="bridge">Language Bridge</button>
    </nav>
    <section id="playground-content" aria-live="polite" aria-busy="false"></section>
    <footer class="corpus-footnote" id="corpus-provenance"></footer>
  </div>
  <script id="playground-config" type="application/json" set:html={config}/>
  <script>import '../../scripts/playground';</script>
</BaseLayout>
